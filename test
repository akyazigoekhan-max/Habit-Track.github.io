import React from "react";
import { Doughnut } from "react-chartjs-2";
import { Chart as ChartJS, ArcElement, Tooltip, Legend } from "chart.js";

ChartJS.register(ArcElement, Tooltip, Legend);

const StatisticsChart = ({ successPercentage }) => {
  const data = {
    labels: ["Erreicht", "Nicht erreicht"],
    datasets: [
      {
        label: "Erfolg in %",
        data: [successPercentage, 100 - successPercentage],
        backgroundColor: ["#4ade80", "#f87171"], // grün / rot
        borderColor: ["#4ade80", "#f87171"],
        borderWidth: 2,
      },
    ],
  };

  const options = {
    cutout: "70%", // innerer Kreis (Ringdiagramm)
    plugins: {
      legend: {
        position: "bottom",
      },
      tooltip: {
        enabled: true,
      },
    },
  };

  return (
    <div style={{ width: "250px", margin: "auto" }}>
      <Doughnut data={data} options={options} />
      <p style={{ textAlign: "center", marginTop: "10px" }}>
        {successPercentage}% erreicht
      </p>
    </div>
  );
};

export default StatisticsChart;
